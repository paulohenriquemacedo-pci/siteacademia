<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve as tags Open Graph para bots no próprio URL do post
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|facebot|twitterbot|linkedinbot|whatsapp|telegrambot|slackbot|discordbot|googlebot|bingbot|applebot) [NC]
  RewriteRule ^blog/([^/]+)$ /blog-handler.php?slug=$1 [L]

  # Ferramenta interna do gerador de conteúdo (página estática, fora do SPA)
  RewriteRule ^gerador/?$ /gerador/index.html [L]

  # SPA Routing padrão
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
